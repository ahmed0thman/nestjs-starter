// ================================
// Login History Model
// ================================

model LoginHistory {
  id            String      @id @default(dbgenerated("uuidv7()"))
  userId        String?
  action        loginAction
  ipAddress     String?
  userAgent     String?
  device        String?
  deviceId      String?
  deviceType    String?
  os            String?
  browser       String?
  geoCountry    String?
  geoCity       String?
  geoLatitude   Float?
  geoLongitude  Float?
  isSecure      Boolean     @default(false)
  success       Boolean
  failureReason String?
  isSuspicious  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jwtSessions JwtSession[]

  @@index([userId, action])
  @@index([deviceId])
}

// ================================
// Email History Model
// ================================

model EmailHistory {
  id            String          @id @default(uuid())
  authId        String
  emailTo       String
  emailType     email_type
  subject       String
  emailProvider email_provider? @default(smtp)
  messageId     String //
  emailStatus   email_status    @default(pending)
  retry_count   Int             @default(0)
  ipAddress     String?
  userAgent     String?
  sentAt        DateTime        @default(now())
  errorMessage  String?
  createdAt     DateTime        @default(now())

  // Relations
  authUser User @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId, messageId, sentAt])
  @@index([messageId])
}
